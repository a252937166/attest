+_COMPONENT = re.compile(r"(\d+)(ms|[dhms])")
+_SECONDS = {"d": 86400, "h": 3600, "m": 60, "s": 1, "ms": 0.001}
+_ORDER = {"d": 5, "h": 4, "m": 3, "s": 2, "ms": 1}
 
 
