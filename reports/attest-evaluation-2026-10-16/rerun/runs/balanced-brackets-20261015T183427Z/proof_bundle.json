  "spec": {
    "feasible": true,
    "infeasibility_reason": null,
    "restated_task": "Implement the is_balanced(s) function in brackets/core.py to check if a string has balanced and properly nested brackets of three types: (), [], {}. Non-bracket characters are ignored. The function must return a boolean (True for balanced, False otherwise). It must raise TypeError if the input is not a string. The existing is_bracket helper function and the test suite must not be modified.",
    "interface_contract": [
      {
        "name": "is_bracket",
        "signature": "is_bracket(c: Any) -> bool",
        "behavior": "Returns True if c is a single-character string and one of the six bracket characters '(', ')', '[', ']', '{', '}'. Returns False otherwise (including for non-strings, empty strings, or strings of length >1).",
        "error_cases": []
      },
      {
        "name": "is_balanced",
        "signature": "is_balanced(s: str) -> bool",
        "behavior": "Returns True if all brackets in the string s are correctly matched and properly nested, ignoring any non-bracket characters. Returns False if brackets are unmatched, incorrectly nested, or if there are extra closing or opening brackets. The empty string returns True.",
        "error_cases": [
          "TypeError: raised when s is not a string."
        ]
      }
    ],
    "acceptance_criteria": [
      "1. is_balanced('') returns True.",
      "2. is_balanced('()') returns True.",
      "3. is_balanced('[]') returns True.",
      "4. is_balanced('{}') returns True.",
      "5. is_balanced('()[]{}') returns True.",
      "6. is_balanced('([{}])') returns True.",
      "7. is_balanced('(a[b]{c})') returns True.",
      "8. is_balanced('f(x[0], y[1])') returns True.",
      "9. is_balanced('(') returns False.",
      "10. is_balanced(')') returns False.",
      "11. is_balanced('([)]') returns False.",
      "12. is_balanced('(]') returns False.",
      "13. is_balanced('{[}') returns False.",
      "14. is_balanced('())') returns False.",
      "15. Non-bracket characters are ignored: is_balanced('a') returns True, is_balanced('(a') returns False, is_balanced('a)') returns False.",
      "16. is_balanced returns a bool (True or False) for all string inputs.",
      "17. is_balanced raises TypeError when s is not a string (e.g., None, 123, [], {}).",
      "18. Existing is_bracket behavior is preserved: is_bracket(c) returns True for each of '(', ')', '[', ']', '{', '}' and False for any other input."
    ],
    "out_of_scope": [
      "Do not modify the is_bracket function.",
      "Do not modify the test files (tests/test_basic.py).",
      "Do not change the PAIRS, OPEN, CLOSE constants unless necessary for the implementation (but they are provided and should be used)."
    ],
