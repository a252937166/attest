    "diff": "--- a/durationkit/parse.py\n+++ b/durationkit/parse.py\n@@ -4,12 +4,76 @@\n def parse_duration(text: str) -> float:\n     \"\"\"Parse a duration string and return the number of seconds as a float.\n \n-    Only a plain non-negative integer number of seconds is accepted at the\n-    moment, for example ``\"90\"``. Surrounding whitespace is ignored.\n+    Accepts a plain non-negative integer number of seconds (e.g. \"90\") or a sequence\n+    of components with units: days (d), hours (h), minutes (m), seconds (s),\n+    milliseconds (ms). Components must be in descending order (e.g. \"2d4h\",\n+    \"1h30m\"), each unit may appear at most once, and whitespace is allowed around\n+    the string and between components (but not between a number and its unit).\n+\n+    Returns the total seconds as a float.\n     \"\"\"\n     if not isinstance(text, str):\n         raise TypeError(\"duration must be a string\")\n     stripped = text.strip()\n-    if not stripped.isdigit():\n+    if not stripped:\n         raise ValueError(f\"unsupported duration: {text!r}\")\n-    return float(stripped)\n+\n+    # Legacy format: plain integer seconds\n+    if stripped.isdigit():\n+        return float(stripped)\n+\n+    # Component format\n+    total = 0.0\n+    seen_units = set()\n+    last_unit_index = -1  # index in the order list, we require increasing indices (descending units)\n+    order = {'d': 0, 'h': 1, 'm': 2, 's': 3, 'ms': 4}\n+    multipliers = {'d': 86400.0, 'h': 3600.0, 'm': 60.0, 's': 1.0, 'ms': 0.001}\n+\n+    i = 0\n+    n = len(stripped)\n+    while i < n:\n+        # Skip whitespace between components\n+        while i < n and stripped[i].isspace():\n+            i += 1\n+        if i >= n:\n+            break  # trailing whitespace\n+\n+        # Parse number (one or more digits)\n+        start_num = i\n+        while i < n and stripped[i].isdigit():\n+            i += 1\n+        if start_num == i:\n+            raise ValueError(f\"unsupported duration: {text!r}\")\n+        num_str = stripped[start_num:i]\n+        value = int(num_str)\n+\n+        # Immediately after number we must have a unit (no whitespace allowed)\n+        if i >= n:\n+            raise ValueError(f\"unsupported duration: {text!r}\")\n+\n+        # Check for unit: try 'ms' first then single letter\n+        unit = None\n+        if i + 1 < n and stripped[i:i+2] == 'ms':\n+            unit = 'ms'\n+            i += 2\n+        elif stripped[i] in 'dhms':\n+            unit = stripped[i]\n+            i += 1\n+        else:\n+            raise ValueError(f\"unsupported duration: {text!r}\")\n+\n+        # Validate unit\n+        if unit in seen_units:\n+            raise ValueError(f\"unsupported duration: {text!r}\")\n+        seen_units.add(unit)\n+\n+        # Check order\n+        current_idx = order[unit]\n+        if last_unit_index != -1 and current_idx <= last_unit_index:\n+            raise ValueError(f\"unsupported duration: {text!r}\")\n+        last_unit_index = current_idx\n+\n+        # Add to total\n+        total += value * multipliers[unit]\n+\n+    return total\n",
