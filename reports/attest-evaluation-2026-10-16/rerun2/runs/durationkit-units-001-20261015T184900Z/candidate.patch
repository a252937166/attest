+            i += 2
+        elif s[i] in 'dhms':
+            unit = s[i]
+            i += 1
+        else:
+            raise ValueError(f"unknown unit in duration: {text!r}")
+
+        # check repetition
+        if unit in seen:
+            raise ValueError(f"repeated unit '{unit}' in duration: {text!r}")
+        seen.add(unit)
+
+        # check order
+        cur_order = order[unit]
+        if cur_order <= last_order:
+            raise ValueError(f"units out of descending order in duration: {text!r}")
+        last_order = cur_order
+
+        # add to total
+        if unit == 'd':
+            total += value * 86400.0
+        elif unit == 'h':
+            total += value * 3600.0
+        elif unit == 'm':
+            total += value * 60.0
+        elif unit == 's':
+            total += value * 1.0
+        elif unit == 'ms':
+            total += value * 0.001
+        else:
+            # shouldn't happen
+            raise ValueError(f"unsupported unit: {unit}")
+
