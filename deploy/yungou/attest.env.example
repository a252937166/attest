# /etc/attest/attest.env  (root:attest 0640). Never commit real values.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=aiproject-e00p460g3mgey447tt
NEBIUS_AI_PROJECT=aiproject-e00p460g3mgey447tt
CODEX_API_KEY=
TAVILY_API_KEY=
ATTEST_ADMIN_TOKEN=
ATTEST_PER_RUN_USD_CAP=0.5
ATTEST_DAILY_USD_CAP=2.0
ATTEST_PUBLIC_RUNS_PER_HOUR=3
# Disk guard and bounded retention (the DogYun volume runs near 90% full).
ATTEST_RETENTION_KEEP=25
ATTEST_RETENTION_KEEP_ERRORS=10
ATTEST_MIN_FREE_MB=500
ATTEST_MIN_FREE_FRAC=0.05
# Visitor identity (API-01): the nginx edge on this host overwrites X-Forwarded-For with the real peer; only its address is trusted.
ATTEST_TRUSTED_PROXIES=127.0.0.1,::1
# Lifetime in seconds of the run-scoped, read-only download tickets that team downloads use instead of the team token
# (R5-07); tickets are signed with a per-process secret and authorise only that run's artifact and zip downloads.
ATTEST_DOWNLOAD_TICKET_SECONDS=600
# Per-run model-call cap of every paid console run (R5-05): the provider refuses call N+1 before dispatch and records the cap in
# the bundle's profile.provider. 22 is the cap of the paid proposal in FREEZE.md and the built-in default.
ATTEST_PER_RUN_MAX_CALLS=22
