#!/bin/bash
# Dispatcher installed as <venv>/bin/python by the python3.12 shim. "-m pip install" writes stub packages into the fake venv (or
# fails when REHEARSAL_PIP_FAIL=1); "-m pip freeze" lists them; anything else (compileall, -c, stdin programs) runs on the real
# interpreter with the stubs importable, so the dependency import check passes without network and the attest import checks are real.
venv=$(cd "$(dirname "$0")/.." && pwd)
real=$(cat "$venv/real-python" 2>/dev/null || true)
[ -n "$real" ] || real=${REHEARSAL_REAL_PYTHON:-python3}
site="$venv/lib/site-packages"
if [ -n "${REHEARSAL_DIR:-}" ]; then
  mkdir -p "$REHEARSAL_DIR/logs"
  printf '%s venv-python(%s) %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$venv" "$*" >> "$REHEARSAL_DIR/logs/shim-calls.log"
fi
if [ "${1:-}" = "-m" ] && [ "${2:-}" = "pip" ]; then
  shift 2
  sub=${1:-}; [ $# -eq 0 ] || shift
  case "$sub" in
    install)
      if [ "${REHEARSAL_PIP_FAIL:-0}" = 1 ]; then
        echo "ERROR: rehearsal-injected dependency installation failure" >&2
        exit 1
      fi
      reqs=""
      while [ $# -gt 0 ]; do
        case "$1" in
          -r) while IFS= read -r line || [ -n "$line" ]; do line=${line%%#*}; line=$(echo $line); [ -z "$line" ] || reqs="$reqs $line"; done < "$2"; shift 2 ;;
          -*) shift ;;
          *) reqs="$reqs $1"; shift ;;
        esac
      done
      for req in $reqs; do
        name=${req%%\[*}; name=${name%%=*}; name=${name%%<*}; name=${name%%>*}; name=${name%%!*}; name=${name%%~*}; name=${name%%;*}
        case "$req" in *==*) ver=${req#*==}; ver=${ver%%;*} ;; *) ver="" ;; esac
        mod=$(printf '%s' "$name" | tr '-' '_')
        mkdir -p "$site/$mod"
        printf '"""rehearsal stub for %s (no real package installed)"""\n__version__ = "%s"\n' "$req" "${ver:-0}" > "$site/$mod/__init__.py"
        printf '%s\n' "$req" >> "$venv/installed.txt"
      done
      exit 0 ;;
    freeze) cat "$venv/installed.txt" 2>/dev/null; exit 0 ;;
    *) exit 0 ;;
  esac
fi
export PYTHONPATH="$site${PYTHONPATH:+:$PYTHONPATH}"
exec "$real" "$@"
